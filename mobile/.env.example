# Public Supabase project URL from Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=

# Public Supabase anon key only. Do not put service role keys in mobile.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Production HTTPS backend origin. For real devices and store builds, use a deployed API URL.
EXPO_PUBLIC_API_BASE_URL=

# Public site origin used to open legal pages from Settings.
EXPO_PUBLIC_SITE_URL=https://YOUR_DOMAIN.com

# Public support email shown in legal/contact screens.
EXPO_PUBLIC_SUPPORT_EMAIL=shkruajshpejt@gmail.com

# Expo project UUID from: cd mobile; npx eas-cli@latest init
# Keep this as a plain EAS environment variable, not an EXPO_PUBLIC value.
EAS_PROJECT_ID=
